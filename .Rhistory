# 把title列按"-"拆分成两列
metadata <- metadata %>%
# 先把行名转成单独的列，防止处理中行名丢失
rownames_to_column("sample_id") %>%
# 拆分title列，最多拆成2部分（遇到多个"-"也只在第一个"-"的位置拆分）
separate(col = title,
into = c("title_part1", "title_part2"),
sep = "-",
extra = "merge",  # 多余的内容全部合并到第二列，避免丢数据
remove = FALSE) %>%  # 保留原来的完整title列方便核对
# 把行名还原回去
column_to_rownames("sample_id")
