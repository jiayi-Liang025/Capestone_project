library(GEOquery)
library(tidyverse)
library(ComplexHeatmap)
library(factoextra)
library(ggrepel)
library(GGally)
gse <- getGEO("GSE163151")
metadata <- pData(gse$GSE163151_series_matrix.txt.gz)
metadata <- metadata |>
select(
"title"
) |>
separate(
title,
into = c("condition", "sample_id"),
sep = "_",
extra = "merge"
)
metadata$count_id <- sub(
"_S[0-9]+_L00([0-9]+)$",
"_\\1",
metadata$sample_id
)
head(metadata)
